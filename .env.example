POSTGRES_DB=life_easy
POSTGRES_USER=life_easy
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# Docker services use `postgres` as the host. Use URL-encoded credentials.
DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}?sslmode=disable
# Use this URL in DataGrip running on your computer.
DATABASE_URL_LOCAL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}?sslmode=disable

DB_HOST=postgres
DB_PORT=5432
DB_SSLMODE=disable

JWT_SECRET=

GRAFANA_USER=admin
GRAFANA_PASSWORD=

PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=
